# ==============================================================================
# Configurações do Proton VPN to Tailscale Bridge
# ==============================================================================

# 1. Tipo de VPN
# Valores suportados:
# - auto      : Detecta automaticamente o ficheiro presente (protonvpn.conf ou protonvpn.ovpn)
# - wireguard : Usa a configuração do WireGuard (Recomendado pela velocidade e performance)
# - openvpn   : Usa a configuração do OpenVPN
VPN_TYPE=auto

# 2. Configurações do Tailscale
# Chave de autenticação gerada na consola do Tailscale (Settings -> Keys -> Generate Auth Key)
# Recomendado: Ativar a opção "Reusable" (Reutilizável) e "Ephemeral" (se desejar que o nó seja limpo ao desligar).
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX-XXXXXXXXXXXXXXXX

# Nome amigável do dispositivo que aparecerá no seu painel Tailscale (Tailnet)
TS_HOSTNAME=protonvpn-bridge

# Argumentos extra para o comando 'tailscale up' (Opcional)
TS_EXTRA_ARGS=

# 3. Credenciais OpenVPN (Apenas necessárias se usar OpenVPN)
# Estas credenciais NÃO são o utilizador e palavra-passe da sua conta Proton principal.
# Obtenha-as em: account.proton.me -> Downloads -> OpenVPN / IKEv2 username and password
PROTONVPN_USER=
PROTONVPN_PASSWORD=

# 4. Web UI de Configuração
# Porta onde a interface web fica disponível no host (http://<host>:WEBUI_PORT)
WEBUI_PORT=8080
# Credenciais de acesso à Web UI (autenticação HTTP Basic).
# Se WEBUI_PASSWORD ficar em branco, é gerada uma palavra-passe aleatória a cada
# arranque do container e impressa nos logs (docker compose logs webui) -
# recomenda-se definir um valor fixo aqui.
WEBUI_USERNAME=admin
WEBUI_PASSWORD=
