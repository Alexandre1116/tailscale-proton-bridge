# ==============================================================================
# Configurações do Proton VPN to Tailscale Bridge
# ==============================================================================

# 1. Tipo de VPN
# Valores suportados:
# - auto      : Detecta automaticamente o ficheiro presente (protonvpn.conf ou protonvpn.ovpn)
# - wireguard : Usa a configuração do WireGuard (Recomendado pela velocidade e performance)
# - openvpn   : Usa a configuração do OpenVPN
VPN_TYPE=auto

# 2. Configurações do Tailscale
# Chave de autenticação gerada na consola do Tailscale (Settings -> Keys -> Generate Auth Key)
# Para este serviço de longa duração, prefira uma chave reutilizável, tagged e
# pre-authorized. Use uma chave ephemeral apenas para instâncias descartáveis.
TS_AUTHKEY=
# Alternativa mais segura: caminho de um ficheiro root-only dentro do container.
# TS_AUTHKEY_FILE=/run/secrets/ts_authkey

# Nome amigável do dispositivo que aparecerá no seu painel Tailscale (Tailnet)
TS_HOSTNAME=protonvpn-bridge

# Argumentos extra para o comando 'tailscale up' (Opcional)
TS_EXTRA_ARGS=

# 3. Credenciais OpenVPN (Apenas necessárias se usar OpenVPN)
# Estas credenciais NÃO são o utilizador e palavra-passe da sua conta Proton principal.
# Obtenha-as em: account.proton.me -> Downloads -> OpenVPN / IKEv2 username and password
PROTONVPN_USER=
PROTONVPN_PASSWORD=
# PROTONVPN_USER_FILE=/run/secrets/protonvpn_user
# PROTONVPN_PASSWORD_FILE=/run/secrets/protonvpn_password

# 4. Web UI de Configuração
# Porta onde a interface web fica disponível no host (http://<host>:WEBUI_PORT)
WEBUI_PORT=8080
# Credenciais obrigatórias de acesso à Web UI.
WEBUI_USERNAME=admin
WEBUI_PASSWORD=
# Alternativa: guardar a password em secrets/webui_password.
# WEBUI_PASSWORD_FILE=/run/secrets/webui_password

# Transporte da Web UI: http ou https.
WEBUI_PROTOCOL=http
# https requer certificados legíveis no host:
# ./webui/certs/fullchain.pem e ./webui/certs/privkey.pem
WEBUI_CERT_FILE=/certs/fullchain.pem
WEBUI_KEY_FILE=/certs/privkey.pem

# all publica em todas as interfaces. tailnet restringe a autenticação a IPs
# Tailscale e deve ser usado com WEBUI_BIND_ADDRESS=100.x.y.z.
WEBUI_ACCESS_MODE=all
WEBUI_BIND_ADDRESS=0.0.0.0
# Opcional. Sobrescreve as redes permitidas no modo tailnet.
WEBUI_ALLOWED_CIDRS=

# O bridge sai e reinicia depois deste número de falhas consecutivas.
VPN_CHECK_INTERVAL=30
VPN_FAILURE_THRESHOLD=3
VPN_HEALTHCHECK_URL=https://api.ipify.org
STATUS_UPDATE_INTERVAL=2
