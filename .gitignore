*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
ENV/

# Runtime status and logs
*.log
status.json

# IDEs & System files
.vscode/
.idea/
.claude/
.agents/
.DS_Store
Thumbs.db
Desktop.ini
