# Environment & Secrets (NEVER COMMIT SENSITIVE DATA)
.env
.env.*
!.env.example

# VPN configuration files & credentials
vpn/wireguard/*
!vpn/wireguard/.gitkeep
vpn/openvpn/*
!vpn/openvpn/.gitkeep
*.conf
*.ovpn
credentials.txt

# Python & WebUI
